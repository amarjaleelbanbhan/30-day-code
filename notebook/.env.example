# PostgreSQL with pgvector + pg_trgm
DATABASE_URL=postgres://nb:nb@localhost:5432/notebook

# Where uploaded files are stored (local disk adapter; swap for S3-compatible storage in src/lib/storage.ts)
STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=50

# LLM provider: "anthropic" | "openai" (any OpenAI-compatible endpoint) | unset = retrieval-only mode
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Embeddings (OpenAI-compatible /embeddings endpoint: OpenAI, Voyage-compatible proxies, Ollama, ...)
# Unset = keyword + fuzzy search only.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

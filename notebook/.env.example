# PostgreSQL with pgvector + pg_trgm
DATABASE_URL=postgres://nb:nb@localhost:5432/notebook

# Uploaded files (local disk adapter; swap for S3-compatible storage in src/lib/storage.ts)
STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=50

# LLM: ollama | openai (any OpenAI-compatible server) | anthropic | none (default: search-only)
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=
LLM_API_KEY=
# LLM_CONTEXT_TOKENS=8192

# Embeddings: ollama | openai | none. Unset = keyword + fuzzy search only.
EMBEDDING_PROVIDER=none
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# EMBEDDING_MIN_SIMILARITY=0.5

# Developer tools (/c/<id>/debug, reindex API) in production builds
# NB_DEBUG=1

# OCR for images and scanned PDFs (local, English). Defaults shown.
# OCR_MIN_CONFIDENCE=60
# OCR_MAX_PAGES=300
# OCR_LANG_PATH=
